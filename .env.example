# Database Configuration
# Local SQLite fallback: sqlite+aiosqlite:///./webhooks.db
# Docker PostgreSQL: postgresql+asyncpg://webhook_user:webhook_password@localhost:5432/webhook_engine
DATABASE_URL=sqlite+aiosqlite:///./webhooks.db

# Redis & ARQ Configuration
REDIS_URL=redis://localhost:6379/0
ARQ_QUEUE_NAME=webhook_queue

# Exponential Backoff Policy
MAX_RETRIES=5
BACKOFF_BASE_SECONDS=1.0
BACKOFF_FACTOR=2.0

# Fault-Tolerance & Lease Heartbeat Configuration
LEASE_DURATION_SECONDS=10
LEASE_HEARTBEAT_INTERVAL=3
WATCHDOG_CHECK_INTERVAL=4

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SSE_URL=http://localhost:8000/api/v1/events/stream
